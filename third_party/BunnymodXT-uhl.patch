+// bxt_precise_fps_limit: the engine only checks its frame limit when its loop comes
+// round, so a frame can start late (measured on 3248: up to 1 ms at fps_max 100 and
+// 2.6 ms at 20) and the late time is simulated. In the last few milliseconds before the
+// deadline, wait for it here on a high-resolution clock instead. The waited time is
+// handed to the engine now and taken back from the next call, whose measurement of real
+// time includes it again, so the game never runs faster than real time or fps_max.
+template<typename Filter>
+static int PreciseFilterTime(Filter filter, float passedTime, bool enabled)
+{
+	constexpr double window = 0.004;
+	static double sinceFrame = 0.0, debt = 0.0;
+	const float fpsMax = CVars::fps_max.GetFloat();
+	if (!enabled || fpsMax <= 0.0f) {
+		sinceFrame = debt = 0.0;
+		return filter(passedTime);
+	}
+
+	const double repaid = std::min(static_cast<double>(passedTime), debt);
+	debt -= repaid;
+	const auto passed = static_cast<float>(passedTime - repaid);
+	if (filter(passed)) {
+		sinceFrame = 0.0;
+		return 1;
+	}
+	sinceFrame += passed;
+
+	const double remaining = 1.0 / fpsMax - sinceFrame;
+	if (remaining <= 0.0 || remaining > window)
+		return 0;
+	const auto start = std::chrono::steady_clock::now();
+	const auto deadline = start + std::chrono::duration<double>(remaining + 1e-6); // past float rounding
+	auto now = start;
+	while (now < deadline)
+		now = std::chrono::steady_clock::now();
+	const double waited = std::chrono::duration<double>(now - start).count();
+	debt += waited;
+	if (filter(static_cast<float>(waited))) {
+		sinceFrame = 0.0;
+		return 1;
+	}
+	sinceFrame += waited;
+	return 0;
+}
