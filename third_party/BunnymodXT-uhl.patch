+// bxt_frametime_stats: what the engine's frame limiter actually produces. Read-only.
+static std::vector<double> frametimeSamples;
+static size_t frametimeSamplesWanted = 0;
+
+static void RecordFrametime(double frametime)
+{
+	if (!frametimeSamplesWanted)
+		return;
+	frametimeSamples.push_back(frametime);
+	if (frametimeSamples.size() < frametimeSamplesWanted)
+		return;
+	frametimeSamplesWanted = 0;
+
+	double sum = 0, shortest = frametimeSamples[0], longest = frametimeSamples[0];
+	std::vector<unsigned> byWholeMs;
+	for (const double t : frametimeSamples) {
+		sum += t;
+		shortest = std::min(shortest, t);
+		longest = std::max(longest, t);
+		const auto ms = static_cast<size_t>(std::max(0.0, std::floor(t * 1000.0)));
+		if (ms >= byWholeMs.size())
+			byWholeMs.resize(ms + 1);
+		++byWholeMs[ms];
+	}
+	const double average = sum / frametimeSamples.size();
+	const float fpsMax = CVars::fps_max.GetFloat();
+	auto &hw = HwDLL::GetInstance();
+	hw.ORIG_Con_Printf("bxt_frametime_stats: %u frames at fps_max %g (target %.3f ms): average %.3f ms (%.2f fps), shortest %.3f ms, longest %.3f ms.\n",
+		static_cast<unsigned>(frametimeSamples.size()), fpsMax, fpsMax > 0 ? 1000.0 / fpsMax : 0.0,
+		average * 1000.0, average > 0 ? 1.0 / average : 0.0, shortest * 1000.0, longest * 1000.0);
+	std::string line = " Frames by whole milliseconds:";
+	for (size_t ms = 0; ms < byWholeMs.size(); ++ms)
+		if (byWholeMs[ms])
+			line += " " + std::to_string(ms) + " ms x" + std::to_string(byWholeMs[ms]);
+	hw.ORIG_Con_Printf("%s\n", line.c_str());
+}
+
