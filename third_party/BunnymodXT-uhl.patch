+// Save backups like the original 1998 engine: saving over "name" keeps the previous save
+// as "name01". The engine's save command is wrapped because SaveGameSlot is not found on
+// every build (e.g. 3248); the copy is only kept if the save really replaced the file.
+void HwDLL::HookSaveCommandIfNeeded()
+{
+	if (saveCommand || !ORIG_Cmd_FindCmd)
+		return;
+	auto cmd = ORIG_Cmd_FindCmd("save");
+	if (!cmd || !cmd->function)
+		return;
+	saveCommand = cmd;
+	ORIG_SaveCommand = cmd->function;
+	cmd->function = SaveWithBackup;
+}
+
+void HwDLL::SaveWithBackup()
+{
+	namespace fs = std::filesystem;
+	auto &hw = HwDLL::GetInstance();
+	auto pEngfuncs = ClientDLL::GetInstance().pEngfuncs;
+	const char *gameDir = pEngfuncs ? pEngfuncs->pfnGetGameDirectory() : nullptr;
+	const std::string name = hw.ORIG_Cmd_Argc() >= 2 ? hw.ORIG_Cmd_Argv(1) : ""; // the save reuses Argv
+	std::error_code error;
+	fs::path save, copy;
+	fs::file_time_type before{};
+	std::uintmax_t beforeSize = 0;
+	bool copied = false;
+
+	if (!name.empty() && name.find_first_of("/\\:") == std::string::npos && name.find("..") == std::string::npos
+		&& gameDir && gameDir[0]) {
+		fs::path folder(gameDir);
+		if (folder.is_relative()) {
+#ifdef _WIN32
+			wchar_t exe[MAX_PATH]{};
+			GetModuleFileNameW(nullptr, exe, MAX_PATH);
+			folder = fs::path(exe).parent_path() / folder;
+#else
+			folder = fs::current_path(error) / folder;
+#endif
+		}
+		save = folder / "SAVE" / (name + ".sav");
+		copy = folder / "SAVE" / (name + "01.sav.tmp");
+		if (fs::is_regular_file(save, error)) {
+			before = fs::last_write_time(save, error);
+			beforeSize = fs::file_size(save, error);
+			copied = fs::copy_file(save, copy, fs::copy_options::overwrite_existing, error);
+		}
+	}
+
+	hw.ORIG_SaveCommand();
+
+	if (!copied)
+		return;
+	const bool replaced = fs::last_write_time(save, error) != before || fs::file_size(save, error) != beforeSize;
+	if (replaced) {
+		const auto previous = copy.parent_path() / (name + "01.sav");
+		fs::remove(previous, error);
+		fs::rename(copy, previous, error);
+		if (!error) {
+			hw.ORIG_Con_Printf("Previous save kept as %s01.\n", name.c_str());
+			return;
+		}
+	}
+	fs::remove(copy, error);
+}
