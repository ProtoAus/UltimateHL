+#ifdef _WIN32
+// UltimateHL's adapter (UHLCompat.dll next to hl.exe) adapts a stock client.dll in memory, so
+// the client stays unmodified on disk. It has to run before the client's exports are looked
+// up, here and by the engine; a client patched on disk loads the adapter itself and is skipped.
+static void AttachUltimateHL(void* client)
+{
+	wchar_t path[MAX_PATH]{};
+	const auto length = GetModuleFileNameW(nullptr, path, MAX_PATH);
+	auto slash = wcsrchr(path, L'\\');
+	if (!length || length >= MAX_PATH || !slash || wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - path), L"UHLCompat.dll"))
+		return;
+	if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES)
+		return;
+	auto uhl = LoadLibraryW(path);
+	auto attach = uhl ? reinterpret_cast<int (__cdecl *)(HMODULE)>(GetProcAddress(uhl, "UHL_AttachClient")) : nullptr;
+	if (attach && attach(static_cast<HMODULE>(client)))
+		EngineDevMsg("[client dll] UltimateHL adapter attached to the unmodified client.\n");
+}
+#endif
