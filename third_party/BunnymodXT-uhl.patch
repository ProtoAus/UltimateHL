+// The engine's command list lives on its heap, which may be gone when the process exits.
+static bool StillWritable(const void *address)
+{
+#ifdef _WIN32
+	MEMORY_BASIC_INFORMATION info{};
+	return VirtualQuery(address, &info, sizeof(info)) && info.State == MEM_COMMIT && !(info.Protect & PAGE_GUARD)
+		&& (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY));
+#else
+	return address != nullptr;
+#endif
+}
