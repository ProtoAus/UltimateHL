+private:
+	// Shows the crosshair sprites/weapon_<name>.txt has for the current resolution, if any.
+	static void Show(cl_enginefunc_t *pEngfuncs, const std::string &name)
+	{
+		SCREENINFO si{};
+		si.iSize = sizeof(si);
+		pEngfuncs->pfnGetScreenInfo(&si);
+		const int res = (si.iWidth < 640) ? 320 : 640; // Same rule as the client's HUD.
+
+		// The engine allocates sprite lists and never frees them (the client keeps its own forever), so load each once.
+		static std::unordered_map<std::string, std::pair<client_sprite_t *, int>> lists;
+		auto it = lists.find(name);
+		if (it == lists.end()) {
+			const std::string path = "sprites/weapon_" + name + ".txt";
+			int count = 0;
+			auto list = pEngfuncs->pfnSPR_GetList(const_cast<char *>(path.c_str()), &count);
+			it = lists.emplace(name, std::make_pair(list, list ? count : 0)).first;
+		}
+
+		const auto [list, count] = it->second;
+		for (auto p = list; p && p < list + count; ++p) {
+			if (p->iRes == res && !std::strcmp(p->szName, "crosshair")) {
+				const std::string sprite = std::string("sprites/") + p->szSprite + ".spr";
+				pEngfuncs->pfnSetCrosshair(pEngfuncs->pfnSPR_Load(sprite.c_str()), p->rc, 255, 255, 255);
+				return;
+			}
+		}
+		HwDLL::GetInstance().ORIG_Con_Printf("bxt_set_crosshair: sprites/weapon_%s.txt has no %d crosshair.\n", name.c_str(), res);
+	}
+};
